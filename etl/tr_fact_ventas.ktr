                    </value>
                  </condition>
                  <condition>
                    <negated>N</negated>
                    <operator>AND</operator>
                    <conditions>
                      <condition>
                        <negated>N</negated>
                        <leftvalue>monto_bruto</leftvalue>
                        <function>&gt;=</function>
                        <rightvalue/>
                        <value>
                          <name>constant</name>
                          <type>Integer</type>
                          <text>0</text>
                          <length>-1</length>
                          <precision>0</precision>
                          <isnull>N</isnull>
                          <mask>####0.0#########;-####0.0#########</mask>
                        </value>
                      </condition>
                      <condition>
                        <negated>N</negated>
                        <operator>AND</operator>
                        <conditions>
                          <condition>
                            <negated>N</negated>
                            <leftvalue>descuento</leftvalue>
                            <function>&gt;=</function>
                            <rightvalue/>
                            <value>
                              <name>constant</name>
                              <type>Integer</type>
                              <text>0</text>
                              <length>-1</length>
                              <precision>0</precision>
                              <isnull>N</isnull>
                              <mask>####0.0#########;-####0.0#########</mask>
                            </value>
                          </condition>
                          <condition>
                            <negated>N</negated>
                            <operator>AND</operator>
                            <conditions>
                              <condition>
                                <negated>N</negated>
                                <leftvalue>monto_neto</leftvalue>
                                <function>&gt;=</function>
                                <rightvalue/>
                                <value>
