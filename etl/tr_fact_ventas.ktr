        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>fecha</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <conditions>
              <condition>
                <negated>N</negated>
