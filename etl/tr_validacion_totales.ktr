    <sql>SELECT COUNT(*) AS destino_filas,
       COALESCE(SUM(cantidad_unidades),0) AS destino_cantidad,
       COALESCE(SUM(monto_bruto),0) AS destino_bruto,
       COALESCE(SUM(descuento),0) AS destino_descuento,
       COALESCE(SUM(monto_neto),0) AS destino_neto
